"""Bazel module definition for CodeCity."""

module(
    name = "codecity",
    version = "0.1.0",
)

# Bazel Skylib - Common utilities
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# Platforms for cross-platform builds
bazel_dep(name = "platforms", version = "1.1.0")

# OCI container rules (modern replacement for rules_docker)
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")

# ===== OCI base images =====
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Node.js 22 (bookworm) for the TypeScript backend. Full image (not -slim)
# because the backend shells out to the git CLI at runtime.
oci.pull(
    name = "node_bookworm",
    digest = "sha256:0557ac14e0d45d02ed563067b82856ca5e7aa3437fa28d98d4350ea9c3d9494a",
    image = "docker.io/library/node",
    platforms = ["linux/amd64"],
    tag = "22-bookworm",
)

# Nginx Alpine for frontend
oci.pull(
    name = "nginx_alpine",
    digest = "sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752",
    image = "docker.io/library/nginx",
    platforms = ["linux/amd64"],
    tag = "alpine",
)

use_repo(oci, "nginx_alpine", "nginx_alpine_linux_amd64", "node_bookworm", "node_bookworm_linux_amd64")
